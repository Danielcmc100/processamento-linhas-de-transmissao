$DEPOSIT, SIGMAX=3.0                                                            
C $DUMMY, XYZ000                                                                
C  dT  >< Tmax >< Xopt >< Copt ><Epsiln>                                        
   1.E-5      .3     60.     60.  1.E-16                                        
     500       1       1       1       1       0               1                
MODELS                                                                          
INPUT                                                                           
  MM0001 {v(X0007A)}                                                            
  MM0002 {v(X0007B)}                                                            
  MM0003 {v(X0007C)}                                                            
  MM0004 {v(X0015A)}                                                            
  MM0005 {v(X0010A)}                                                            
  MM0006 {v(X0010B)}                                                            
  MM0007 {v(X0010C)}                                                            
  MM0008 {v(X0016A)}                                                            
OUTPUT                                                                          
  X0008A                                                                        
  X0009A                                                                        
  X0011A                                                                        
  X0012A                                                                        
MODEL MDLRDR                                                                    
--                                                                              
-- DATA: Defines parameters that are constant throughout the entire simulation. 
DATA total_knt  {dflt: 200}                                                     
                                                                                
-- channel ID table                                                             
-- 1 = T_MAN                                                                    
-- 2 = T_OPO                                                                    
-- 3 = TRANSFORMER                                                              
-- 4 = ...                                                                      
-- add more if needed                                                           
DATA channel_id {dflt: 1}                                                       
                                                                                
-- VAR: variable parameters that might change throought the execution           
-- we ask for the curr_knt so we can later down the pipe, at the graph          
-- properly reset the graph after reaching the end of the current KNT execution 
VAR curr_knt                                                                    
                                                                                
-- Input: defines the signals the model receives from the circuit or other model
-- wanted: Array that contains the values that you want to send to C subroutine 
INPUT wanted[1..3]                                                              
INPUT i2                                                                        
OUTPUT o1, o2                                                                   
VAR o1,o2                                                                       
INIT                                                                            
  o1:=0                                                                         
  o2:=1                                                                         
-- The INIT procedure in MODELS (local) is used to create pre-simulation calculu
-- Here you can initialize internal variables, if necessary.                    
ENDINIT                                                                         
                                                                                
-- Foregin Model Declaration (FOREIGN)                                          
-- 'reader' its the local name that you are going to use in this file.          
-- 'creader' its the NAME OF REGISTER that must be at refnam inside fgnmod.f    
-- {ixdata:3, ixin:5, ixout:0, ixvar:4} defines the size of 4 interface arrays  
-- ixin:5, we want 3 variables (3 phases) + t + current KNT                     
-- ixdata:3, we want the stoptime + total KNTs + channel_id                     
MODEL reader FOREIGN creader {ixdata:3, ixin:5, ixout:0, ixvar:3}               
                                                                                
EXEC                                                                            
  -- here we assign the atp(KNT) to the current KNT                             
  curr_knt := atp(KNT)                                                          
  -- USE: Creates a instance ( a 'object') of the foreign model.                
  -- every 'USE' executes a corresponding C subroutine.                         
  USE reader AS reader                                                          
    DATA                                                                        
      xdata[1] := total_knt                                                     
      xdata[2] := stoptime                                                      
      xdata[3] := channel_id                                                    
    INPUT                                                                       
      -- Passes the values 'wanted' to xin[1..3] of C subroutine.               
      xin[1..3] := wanted[1..3]                                                 
      xin[4] := t                                                               
      xin[5] := curr_knt                                                        
  ENDUSE                                                                        
  o2 := t                                                                       
ENDEXEC                                                                         
ENDMODEL                                                                        
USE MDLRDR AS DEFAULT                                                           
INPUT                                                                           
  wanted[1]:= MM0001                                                            
  wanted[2]:= MM0002                                                            
  wanted[3]:= MM0003                                                            
  i2:= MM0004                                                                   
DATA                                                                            
  channel_id:=         1.                                                       
  total_knt:=        50.                                                        
OUTPUT                                                                          
  X0008A:=o1                                                                    
  X0009A:=o2                                                                    
ENDUSE                                                                          
USE MDLRDR AS DEFAULT                                                           
INPUT                                                                           
  wanted[1]:= MM0005                                                            
  wanted[2]:= MM0006                                                            
  wanted[3]:= MM0007                                                            
